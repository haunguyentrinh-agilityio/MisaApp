{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet list package:*)",
      "Bash(dotnet ef migrations add:*)",
      "Bash(dotnet ef migrations list:*)",
      "Bash(dotnet ef migrations script:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm outdated:*)",
      "Bash(pnpm install:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker compose config:*)",
      "Bash(docker compose up:*)",
      "Bash(docker compose build:*)",
      "Bash(docker compose restart:*)",
      "Bash(docker compose --profile e2e run --rm:*)",
      "Bash(curl -fsS http://localhost:*)",
      "Bash(.specify/scripts/bash/check-prerequisites.sh:*)",
      "Bash(.specify/scripts/bash/resolve-template.sh:*)",
      "Bash(.specify/scripts/bash/setup-plan.sh:*)",
      "Bash(.specify/scripts/bash/setup-tasks.sh:*)",
      "Bash(.specify/extensions/git/scripts/bash/create-new-feature-branch.sh:*)",
      "Bash(bash .specify/scripts/bash/check-prerequisites.sh:*)",
      "Bash(bash .specify/scripts/bash/resolve-template.sh:*)",
      "Bash(bash .specify/scripts/bash/setup-plan.sh:*)",
      "Bash(bash .specify/scripts/bash/setup-tasks.sh:*)",
      "Bash(bash .specify/extensions/git/scripts/bash/create-new-feature-branch.sh:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git commit:*)",
      "Bash(.specify/extensions/git/scripts/bash/auto-commit.sh:*)",
      "Bash(bash .specify/extensions/git/scripts/bash/auto-commit.sh:*)",
      "Bash(docker compose down:*)",
      "Bash(dotnet ef database:*)",
      "Bash(dotnet ef migrations remove:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Write(./.env)",
      "Bash(docker compose down -v:*)",
      "Bash(docker volume rm:*)"
    ]
  }
}
