# Copy to `.env` (git-ignored) and adjust. Read by docker compose.

# Azure SQL dev database (sql-misaapp-nonprod-<suffix> / sqldb-misaapp-dev-<alias>); see docs/deployment.md.
# The password comes from Key Vault kv-misaapp-np-<suffix> (secret sql-admin-password). Avoid ';' in values.
SQL_CONNECTION_STRING=Server=tcp:sql-misaapp-nonprod-<suffix>.database.windows.net,1433;Database=sqldb-misaapp-dev-<alias>;User Id=<admin>;Password=<from Key Vault>;Encrypt=True

# Google Gemini (https://aistudio.google.com/apikey). Leave empty to use the built-in echo model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Host ports
WEB_PORT=3000
API_PORT=8080
