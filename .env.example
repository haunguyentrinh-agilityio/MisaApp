# Copy to `.env` (git-ignored) and adjust. Read by docker compose.

# SQL Server SA password: 8+ chars with upper, lower, digit and symbol. Avoid ';' (breaks the connection string).
MSSQL_SA_PASSWORD=Local_Dev_Passw0rd!

# Google Gemini (https://aistudio.google.com/apikey). Leave empty to use the built-in echo model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Host ports
WEB_PORT=3000
API_PORT=8080
SQL_PORT=1433
